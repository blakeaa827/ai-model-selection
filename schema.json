{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily model selection",
  "type": "object",
  "required": [
    "schema_version",
    "report_date",
    "checked_at",
    "freshness",
    "scope",
    "benchmark",
    "recommendations",
    "models",
    "frontier",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "freshness": {
      "type": "object",
      "required": [
        "recommended_max_age_hours",
        "on_stale"
      ],
      "properties": {
        "recommended_max_age_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "on_stale": {
          "const": "reject_and_request_refresh"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "required": [
        "name",
        "version",
        "cost_metric",
        "score_is_percentage"
      ],
      "properties": {
        "cost_metric": {
          "const": "weighted_USD_per_Intelligence_Index_task"
        },
        "score_is_percentage": {
          "const": false
        }
      }
    },
    "recommendations": {
      "type": "object",
      "required": [
        "floor",
        "ceiling"
      ],
      "properties": {
        "floor": {
          "$ref": "#/$defs/recommendation"
        },
        "ceiling": {
          "$ref": "#/$defs/recommendation"
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1
    },
    "frontier": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/configuration"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "subscription_recommendations": {
      "type": "object",
      "required": [
        "account_tiers",
        "services",
        "cost_basis",
        "verified_at"
      ],
      "properties": {
        "account_tiers": {
          "type": "object"
        },
        "cost_basis": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "services": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "service",
              "personal_tier",
              "recommendations",
              "sources"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "personal_tier": {
                "type": "null"
              },
              "recommendations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "role",
                    "model_label",
                    "surface",
                    "control",
                    "eligibility",
                    "intelligence_score",
                    "benchmark_task_cost_usd"
                  ],
                  "properties": {
                    "intelligence_score": {
                      "type": "null"
                    },
                    "benchmark_task_cost_usd": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "limited_free_configurations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configuration"
      }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "model",
        "reasoning",
        "provider"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "reasoning": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "effort"
              ],
              "properties": {
                "effort": {
                  "enum": [
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              },
              "not": {
                "required": [
                  "enabled"
                ]
              }
            },
            {
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "not": {
                "required": [
                  "effort"
                ]
              }
            }
          ]
        },
        "provider": {
          "type": "object",
          "required": [
            "only",
            "require_parameters",
            "allow_fallbacks"
          ],
          "properties": {
            "only": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "require_parameters": {
              "const": true
            },
            "allow_fallbacks": {
              "const": false
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "configuration_id",
        "openrouter_model_id",
        "effort",
        "intelligence_score",
        "benchmark_task_cost_usd",
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            null
          ]
        },
        "intelligence_score": {
          "type": "number",
          "minimum": 0
        },
        "benchmark_task_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "api_endpoint": {
          "enum": [
            "https://openrouter.ai/api/v1/responses",
            "https://openrouter.ai/api/v1/chat/completions"
          ]
        }
      }
    },
    "configuration": {
      "allOf": [
        {
          "$ref": "#/$defs/recommendation"
        },
        {
          "type": "object",
          "required": [
            "minimum_score_exclusive",
            "maximum_score_inclusive",
            "openrouter_canonical_slug",
            "openrouter_verified_at",
            "benchmark_source_url",
            "api_call_tested",
            "marginal"
          ],
          "properties": {
            "minimum_score_exclusive": {
              "type": [
                "number",
                "null"
              ]
            },
            "maximum_score_inclusive": {
              "type": "number"
            },
            "openrouter_canonical_slug": {
              "type": "string"
            },
            "openrouter_verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "benchmark_source_url": {
              "type": "string",
              "format": "uri"
            },
            "api_call_tested": {
              "type": "boolean"
            },
            "marginal": {
              "type": [
                "object",
                "null"
              ]
            },
            "benchmark_verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "minimum_budget_inclusive": {
              "type": "number",
              "minimum": 0
            },
            "maximum_budget_exclusive": {
              "type": [
                "number",
                "null"
              ]
            },
            "reasoning_control": {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "effort",
                    "enabled"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "subscription_recommendations",
          "coverage_inventory"
        ],
        "properties": {
          "frontier": {
            "items": {
              "required": [
                "minimum_budget_inclusive",
                "maximum_budget_exclusive",
                "reasoning_control"
              ]
            }
          }
        }
      }
    }
  ]
}
